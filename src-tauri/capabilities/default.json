{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-create",
    "fs:allow-read-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-write",
    "fs:allow-stat",
    "core:window:allow-close",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/*" }, { "path": "$DOWNLOAD/*" }, { "path": "E:/rokningar-backup/*" }, { "path": "E:/rokningar-backup" }]
    }
  ]
}